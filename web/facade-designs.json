{
  "$schema": "../schemas/facade-designs.schema.json",
  "version": 1,
  "kit": 1,
  "description": "Approximate authored facade compositions; parametric primitives interpreted from references, no photographic textures. References and conditions in THIRD_PARTY_NOTICES.md.",
  "license": "ODbL-1.0",
  "attribution": "Anchor vertices from D.G. del Catastro INSPIRE BU; street identifiers © OpenStreetMap contributors",
  "recipes": {
    "mercado-fachada": {
      "description": "Long modern stone facade, upper louvers, dark shopfronts and cafe awnings. Equivalent to the market loop of buildDetailedFacades in main 5666928.",
      "params": {},
      "body": [
        {
          "box": ["len / 2", 4.77, 0.055, "len", 9.5, 0.09],
          "color": "$stone"
        },
        {
          "box": ["len / 2", 1.46, 0.115, "len", 2.92, 0.15],
          "color": "$base"
        },
        {
          "box": ["len / 2", 9.3, 0.37, "len + 0.5", 0.24, 0.85],
          "color": "#ded9c9"
        },
        {
          "box": ["len / 2", 9.62, 0.1, "len + 0.2", 0.3, 0.3],
          "color": "#d9d1bf"
        },
        {
          "let": {
            "bays": "max(3, round(len / 5.15))",
            "step": "len / bays"
          }
        },
        {
          "for": "j",
          "from": 0,
          "while": "j < bays",
          "step": 1,
          "body": [
            {
              "let": {
                "x": "(j + 0.5) * step",
                "ww": "min(2.8, step * 0.65)"
              }
            },
            {
              "box": ["x", 5.32, 0.135, "ww + 0.23", 2.48, 0.12],
              "color": "#a79782"
            },
            {
              "piece": "pane",
              "args": ["x", 5.32, "ww", 2.23, 0.14]
            },
            {
              "box": ["x", 5.88, 0.28, "ww", 0.075, 0.045],
              "color": "$iron"
            },
            {
              "box": ["x - ww * 0.25", 5.32, 0.28, 0.045, 2.23, 0.04],
              "color": "$iron"
            },
            {
              "box": ["x + ww * 0.25", 5.32, 0.28, 0.045, 2.23, 0.04],
              "color": "$iron"
            },
            {
              "box": ["x", 8.08, 0.15, "step - 0.42", 1.7, 0.08],
              "color": "#768580"
            },
            {
              "for": "q",
              "from": "-step / 2 + 0.35",
              "while": "q < step / 2 - 0.25",
              "step": 0.17,
              "body": [
                {
                  "box": ["x + q", 8.08, 0.28, 0.057, 1.75, 0.23],
                  "color": "#e6dfcb"
                }
              ]
            },
            {
              "box": ["x", 1.36, 0.2, "step - 0.63", 2.57, 0.055],
              "color": "#303b3c"
            },
            {
              "for": "k",
              "from": 0,
              "while": "k < 3",
              "step": 1,
              "body": [
                {
                  "box": ["x - step * 0.3 + k * step * 0.3", 1.38, 0.25, 0.055, 2.55, 0.05],
                  "color": "#9a9485"
                }
              ]
            },
            {
              "if": "len > 60 && j % 5 != 2",
              "then": [
                {
                  "box": ["x", 2.94, 0.93, "step - 0.19", 0.1, 1.72],
                  "color": "#d8bf83",
                  "rotation": [0.13, 0, 0]
                },
                {
                  "box": ["x", 2.8, 1.77, "step - 0.16", 0.3, 0.055],
                  "color": "#d8bf83"
                },
                {
                  "box": ["x", 3.06, 0.34, "step - 0.1", 0.085, 0.12],
                  "color": "#645949"
                }
              ]
            }
          ]
        },
        {
          "for": "y",
          "from": 0.45,
          "while": "y < 2.8",
          "step": 0.46,
          "body": [
            {
              "box": ["len / 2", "y", 0.198, "len", 0.018, 0.02],
              "color": "#a78770"
            },
            {
              "for": "x",
              "from": "(round(y / 0.46) % 2) * 0.57",
              "while": "x < len",
              "step": 1.14,
              "body": [
                {
                  "box": ["x", "y - 0.23", 0.198, 0.018, 0.44, 0.02],
                  "color": "#a78770"
                }
              ]
            }
          ]
        },
        {
          "for": "x",
          "from": 0,
          "while": "x < len",
          "step": 1.35,
          "body": [
            {
              "box": ["x", 5.1, 0.13, 0.016, 4, 0.018],
              "color": "#b5a78f"
            }
          ]
        },
        {
          "for": "y",
          "from": 3.35,
          "while": "y < 7.1",
          "step": 0.76,
          "body": [
            {
              "box": ["len / 2", "y", 0.131, "len", 0.015, 0.02],
              "color": "#b5a78f"
            }
          ]
        },
        {
          "if": "len > 60",
          "then": [
            {
              "piece": "sign",
              "args": [
                {
                  "text": "MERCADO DE ABASTOS"
                },
                "len / 2",
                3.42,
                13,
                0.46,
                "#e7deca",
                "#988571"
              ]
            }
          ]
        }
      ]
    },
    "ayuntamiento-fachada": {
      "description": "Mapped west frontage of the town hall; vertical proportions interpreted from the official elevation and section. Equivalent to the first block of buildDetailedFacades in main 5666928.",
      "params": {},
      "body": [
        {
          "let": {
            "mid": "len * 0.5"
          }
        },
        {
          "box": ["len / 2", 4.72, 0.06, "len", 9.44, 0.1],
          "color": "$ochre"
        },
        {
          "for": "y",
          "from": 0.3,
          "while": "y < 3.8",
          "step": 0.4,
          "body": [
            {
              "box": ["len / 2", "y", 0.12, "len", 0.045, 0.09],
              "color": "#bea166"
            }
          ]
        },
        {
          "box": ["len / 2", 3.9, 0.15, "len + 0.4", 0.24, 0.45],
          "color": "$cream"
        },
        {
          "box": ["len / 2", 4.12, 0.15, "len + 0.4", 0.13, 0.56],
          "color": "$cream"
        },
        {
          "box": ["len / 2", 8.76, 0.15, "len + 0.4", 0.2, 0.45],
          "color": "$cream"
        },
        {
          "box": ["len / 2", 9, 0.15, "len + 0.4", 0.18, 0.62],
          "color": "$cream"
        },
        {
          "box": ["len / 2", 9.38, 0.15, "len + 0.4", 0.32, 0.45],
          "color": "$cream"
        },
        {
          "for": "u",
          "in": [1.2, "len - 1.2", "mid - 6.1", "mid - 2.05", "mid + 2.05", "mid + 6.1"],
          "body": [
            {
              "box": ["u", 6.4, 0.21, 0.58, 4.65, 0.32],
              "color": "$cream"
            },
            {
              "box": ["u", 8.63, 0.32, 0.92, 0.2, 0.55],
              "color": "$white"
            },
            {
              "box": ["u", 4.2, 0.32, 0.9, 0.18, 0.5],
              "color": "$white"
            }
          ]
        },
        {
          "for": "j",
          "from": -1,
          "while": "j <= 1",
          "step": 1,
          "body": [
            {
              "let": {
                "x": "mid + j * 4.1"
              }
            },
            {
              "piece": "arch",
              "args": ["x", 0.2, 2.5, 3.35]
            },
            {
              "piece": "civicPane",
              "args": ["x", 5.82, 1.92, 2.45, 0.28]
            },
            {
              "piece": "pediment",
              "args": ["x", 7.18, 2.42]
            },
            {
              "geo": ["TorusGeometry", 0.43, 0.09, 6, 24],
              "at": ["x", 8.03, 0.29],
              "color": "$cream"
            },
            {
              "geo": ["CircleGeometry", 0.35, 24],
              "at": ["x", 8.03, 0.24],
              "color": "#718080"
            },
            {
              "geo": ["TorusGeometry", 1.45, 0.07, 6, 24, "PI"],
              "at": ["x", 7.33, 0.22],
              "color": "$cream"
            }
          ]
        },
        {
          "for": "x",
          "in": [4.25, "len - 4.25"],
          "body": [
            {
              "piece": "civicPane",
              "args": ["x", 1.7, 1.7, 2.45, 0.19]
            },
            {
              "piece": "civicPane",
              "args": ["x", 5.85, 1.75, 2.48, 0.22]
            },
            {
              "piece": "pediment",
              "args": ["x", 7.2, 2.25]
            },
            {
              "piece": "pane",
              "args": ["x", 8.02, 1.7, 0.62, 0.16]
            }
          ]
        },
        {
          "box": ["mid", 4.04, 0.7, 13, 0.28, 1.48],
          "color": "$cream"
        },
        {
          "box": ["mid", 4.85, 1.35, 13, 0.14, 0.23],
          "color": "$cream"
        },
        {
          "for": "u",
          "from": "mid - 6.2",
          "while": "u < mid + 6.3",
          "step": 0.35,
          "body": [
            {
              "geo": ["CylinderGeometry", 0.065, 0.09, 0.61, 6],
              "at": ["u", 4.45, 1.35],
              "color": "$cream"
            },
            {
              "geo": ["SphereGeometry", 0.105, 6, 5],
              "at": ["u", 4.5, 1.35],
              "color": "$cream"
            }
          ]
        },
        {
          "for": "x",
          "in": ["mid - 6.4", "mid - 2.15", "mid + 2.15", "mid + 6.4"],
          "body": [
            {
              "box": ["x", 4.43, 1.32, 0.27, 0.86, 0.3],
              "color": "$cream"
            }
          ]
        },
        {
          "box": ["mid", 10.54, -0.35, 4.9, 2.8, 1.15],
          "color": "$ochre"
        },
        {
          "for": "x",
          "in": ["mid - 2.2", "mid + 2.2"],
          "body": [
            {
              "box": ["x", 10.6, 0.26, 0.37, 2.9, 0.38],
              "color": "$cream"
            }
          ]
        },
        {
          "box": ["mid", 11.99, 0.12, 5.25, 0.26, 1.2],
          "color": "$cream"
        },
        {
          "piece": "pediment",
          "args": ["mid", 11.28, 2.5]
        },
        {
          "geo": ["CircleGeometry", 0.66, 32],
          "at": ["mid", 10.55, 0.3],
          "color": "$cream"
        },
        {
          "geo": ["TorusGeometry", 0.68, 0.045, 6, 32],
          "at": ["mid", 10.55, 0.32],
          "color": "#c1ad8c"
        },
        {
          "for": "i",
          "from": 0,
          "while": "i < 12",
          "step": 1,
          "body": [
            {
              "let": {
                "a": "(i * TAU) / 12"
              }
            },
            {
              "box": ["mid + sin(a) * 0.52", "10.55 + cos(a) * 0.52", 0.34, 0.027, 0.09, 0.018],
              "color": "$iron",
              "rotation": [0, 0, "-a"]
            }
          ]
        },
        {
          "box": ["mid - 0.12", 10.72, 0.36, 0.038, 0.43, 0.02],
          "color": "$iron",
          "rotation": [0, 0, 0.62]
        },
        {
          "box": ["mid + 0.15", 10.55, 0.37, 0.35, 0.032, 0.02],
          "color": "$iron",
          "rotation": [0, 0, 0.1]
        },
        {
          "for": "j",
          "from": 0,
          "while": "j < 3",
          "step": 1,
          "body": [
            {
              "let": {
                "x": "mid + (j - 1) * 3.2"
              }
            },
            {
              "geo": ["CylinderGeometry", 0.025, 0.025, 2.8, 6],
              "at": ["x", 6.18, 1.08],
              "color": "#b1b5ac",
              "rotation": [0.35, 0, 0]
            },
            {
              "for": "k",
              "from": 0,
              "while": "k < 3",
              "step": 1,
              "body": [
                {
                  "box": ["x + 0.43", "6.97 - k * 0.31", 1.57, 0.84, 0.31, 0.025],
                  "color": {
                    "pick": [
                      "#264177",
                      "#264177",
                      "#264177",
                      "#ab2930",
                      "#e2b644",
                      "#ab2930",
                      "#3c8058",
                      "#e8ead8",
                      "#3c8058"
                    ],
                    "index": "j * 3 + k"
                  },
                  "rotation": [0, 0.12, 0]
                }
              ]
            }
          ]
        },
        {
          "for": "x",
          "in": ["mid - 6.15", "mid - 2.05", "mid + 2.05", "mid + 6.15"],
          "body": [
            {
              "box": ["x", 3.25, 0.62, 0.035, 0.55, 0.66],
              "color": "$iron"
            },
            {
              "box": ["x", 2.96, 0.89, 0.31, 0.44, 0.31],
              "color": "$iron"
            },
            {
              "box": ["x", 2.97, 1.055, 0.2, 0.31, 0.02],
              "color": "#dbc68f"
            }
          ]
        },
        {
          "piece": "sign",
          "args": [
            {
              "text": "AYUNTAMIENTO"
            },
            "mid",
            3.64,
            5.4,
            0.3,
            "$cream",
            "#a08754"
          ]
        }
      ]
    },
    "nave": {
      "description": "Church nave walls: plain volume with a top moulding. Storey heights are atypical and the dimensions are visual estimates. Equivalent to nave() in main 5666928.",
      "params": {
        "h": 10.4,
        "color": "#eee9dc"
      },
      "body": [
        {
          "box": ["len / 2", "h / 2", -0.12, "len", "h", 0.28],
          "color": "color"
        },
        {
          "box": ["len / 2", "h - 0.1", 0.06, "len", 0.22, 0.35],
          "color": "color"
        }
      ]
    },
    "portada-jesus-nazareno": {
      "description": "White side facade with ochre bands and a sculpted marble portal, with a corner belfry. Equivalent to the Jesús Nazareno block of buildDetailedFacades in main 5666928.",
      "params": {},
      "body": [
        {
          "let": {
            "x": "len * 0.52"
          }
        },
        {
          "box": ["len / 2", 5.2, 0.09, "len", 10.4, 0.16],
          "color": "#f0ede2"
        },
        {
          "for": "y",
          "in": [3.2, 6.75, 10.2],
          "body": [
            {
              "box": ["len / 2", "y", 0.22, "len", 0.18, 0.4],
              "color": "#bd9038"
            }
          ]
        },
        {
          "for": "u",
          "from": 1.5,
          "while": "u < len",
          "step": 3.6,
          "body": [
            {
              "geo": ["CircleGeometry", 0.28, 20],
              "at": ["u", 8.9, 0.19],
              "color": "#4c5350"
            },
            {
              "geo": ["TorusGeometry", 0.29, 0.045, 6, 20],
              "at": ["u", 8.9, 0.22],
              "color": "$cream"
            }
          ]
        },
        {
          "box": ["x", 3.25, 0.27, 5.8, 6.5, 0.24],
          "color": "$cream"
        },
        {
          "box": ["x", 2.15, 0.43, 2.6, 4.3, 0.09],
          "color": "#433832"
        },
        {
          "box": ["x", 2.15, 0.49, 0.045, 4.2, 0.035],
          "color": "#7d6c55"
        },
        {
          "for": "side",
          "in": [-1, 1],
          "body": [
            {
              "for": "delta",
              "in": [1.8, 2.7],
              "body": [
                {
                  "let": {
                    "xx": "x + side * delta"
                  }
                },
                {
                  "box": ["xx", 0.56, 0.55, 0.7, 1.1, 0.65],
                  "color": "$cream"
                },
                {
                  "piece": "spiralColumn",
                  "args": ["xx"]
                },
                {
                  "box": ["xx", 5, 0.55, 0.75, 0.3, 0.72],
                  "color": "$cream"
                }
              ]
            }
          ]
        },
        {
          "for": "y",
          "in": [5.22, 5.6, 5.88],
          "body": [
            {
              "box": ["x", "y", 0.48, 6.4, 0.16, 0.85],
              "color": "$cream"
            }
          ]
        },
        {
          "geo": ["ArchShape", 2.2, 2.6, 18],
          "at": ["x", 5.98, 0.33],
          "color": "#7d8887"
        },
        {
          "for": "side",
          "in": [-1, 1],
          "body": [
            {
              "piece": "column",
              "args": ["x + side * 1.45", 7.13, 2.4, 0.18, "$cream"]
            },
            {
              "geo": ["TorusGeometry", 0.55, 0.1, 6, 20, "PI"],
              "at": ["x + side * 2", 6.18, 0.42],
              "color": "$cream",
              "rotation": [0, 0, "side < 0 ? 0 : PI"]
            }
          ]
        },
        {
          "piece": "statue",
          "args": ["x", 6.15, 1.25]
        },
        {
          "for": "side",
          "in": [-1, 1],
          "body": [
            {
              "piece": "statue",
              "args": ["x + side * 2.24", 1.2, 0.85]
            }
          ]
        },
        {
          "box": ["x + 0.2", 7.3, 0.66, 0.12, 1.9, 0.12],
          "color": "$cream",
          "rotation": [0, 0, 0.65]
        },
        {
          "box": ["x + 0.15", 7.62, 0.67, 0.75, 0.12, 0.12],
          "color": "$cream",
          "rotation": [0, 0, 0.65]
        },
        {
          "geo": ["TorusGeometry", 1.75, 0.13, 6, 28, "PI"],
          "at": ["x", 8.1, 0.4],
          "color": "$cream"
        },
        {
          "piece": "cross",
          "args": ["x", 10.7]
        },
        {
          "box": ["len - 0.9", 11.3, -1.2, 2.8, 2.2, 2.8],
          "color": "#ede5d4"
        },
        {
          "piece": "belfry",
          "args": ["len - 0.9", 12.4, 2.8, 2.7]
        },
        {
          "box": ["len - 0.9", 15.18, 0.1, 3.2, 0.2, 0.9],
          "color": "#bd9038"
        },
        {
          "piece": "cross",
          "args": ["len - 0.9", 16.15]
        }
      ]
    },
