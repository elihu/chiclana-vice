    "portada-san-juan-bautista": {
      "description": "Three-bay stone facade with giant pilasters and a central pediment. Equivalent to the San Juan Bautista wall block of buildDetailedFacades in main 5666928.",
      "params": {},
      "body": [
        {
          "let": {
            "x": "len / 2",
            "stone": "#c7b495"
          }
        },
        {
          "box": ["x", 7.1, 0.08, "len", 14.2, 0.17],
          "color": "stone"
        },
        {
          "for": "y",
          "from": 0.55,
          "while": "y < 14",
          "step": 0.62,
          "body": [
            {
              "box": ["x", "y", 0.18, "len", 0.023, 0.025],
              "color": "#ab987c"
            },
            {
              "for": "u",
              "from": "(round(y / 0.62) % 2) * 0.75",
              "while": "u < len",
              "step": 1.5,
              "body": [
                {
                  "box": ["u", "y - 0.3", 0.18, 0.022, 0.58, 0.025],
                  "color": "#ab987c"
                }
              ]
            }
          ]
        },
        {
          "for": "u",
          "in": [0.9, "len * 0.29", "len * 0.71", "len - 0.9"],
          "body": [
            {
              "box": ["u", 7, 0.35, 1.2, 13.4, 0.65],
              "color": "stone"
            },
            {
              "box": ["u", 13.3, 0.46, 1.8, 0.48, 0.9],
              "color": "$cream"
            },
            {
              "box": ["u", 0.55, 0.45, 1.75, 0.85, 0.92],
              "color": "stone"
            },
            {
              "for": "side",
              "in": [-1, 1],
              "body": [
                {
                  "geo": ["TorusGeometry", 0.3, 0.08, 6, 16],
                  "at": ["u + side * 0.44", 13.3, 0.91],
                  "color": "$cream"
                }
              ]
            }
          ]
        },
        {
          "for": "yy",
          "in": [13.75, 14.12, 14.45],
          "body": [
            {
              "box": ["x", "yy", 0.46, "len + 0.7", 0.24, 0.95],
              "color": "stone"
            }
          ]
        },
        {
          "for": "u",
          "in": ["len * 0.15", "x", "len * 0.85"],
          "body": [
            {
              "piece": "door",
              "args": ["u", 0.12, "u == x ? 3.3 : 2.7", 4.4]
            },
            {
              "for": "side",
              "in": [-1, 1],
              "body": [
                {
                  "piece": "column",
                  "args": ["u + side * 1.65", 2.6, 4.7, 0.2, "stone"]
                }
              ]
            },
            {
              "piece": "pediment",
              "args": ["u", 5.15, 4.4]
            }
          ]
        },
        {
          "for": "u",
          "in": ["len * 0.15", "len * 0.85"],
          "body": [
            {
              "geo": ["CircleGeometry", 0.88, 28],
              "at": ["u", 8.4, 0.23],
              "color": "#495b61"
            },
            {
              "geo": ["TorusGeometry", 0.94, 0.17, 8, 28],
              "at": ["u", 8.4, 0.3],
              "color": "$cream"
            },
            {
              "geo": ["TorusGeometry", 2.45, 0.13, 6, 30, "PI"],
              "at": ["u", 7.85, 0.26],
              "color": "$cream"
            },
            {
              "piece": "pane",
              "args": ["u", 11.7, 1.9, 0.85, 0.13]
            }
          ]
        },
        {
          "geo": ["ArchShape", 3.7, 4.6, 20],
          "at": ["x", 7.25, 0.2],
          "color": "#706857"
        },
        {
          "for": "side",
          "in": [-1, 1],
          "body": [
            {
              "piece": "column",
              "args": ["x + side * 2.35", 9.35, 4.6, 0.23, "$cream"]
            }
          ]
        },
        {
          "piece": "pediment",
          "args": ["x", 11.85, 5.7]
        },
        {
          "piece": "balcony",
          "args": ["x", 7.08, 5.6, "$cream", 0.75]
        },
        {
          "piece": "pediment",
          "args": ["x", 14.6, "len * 0.7"]
        },
        {
          "geo": ["TorusGeometry", 0.93, 0.18, 8, 28],
          "at": ["x", 16.1, 0.52],
          "color": "$cream"
        }
      ]
    },
    "cupula-san-juan-bautista": {
      "description": "Cúpula en coordenadas globales en planta (anclaje world), detrás de San Juan Bautista; alturas relativas a la base del monumento.",
      "params": {},
      "body": [
        {
          "geo": ["SphereGeometry", 4.7, 24, 12, 0, "TAU", 0, "PI / 2"],
          "at": [236.7, 14.3, 177.2],
          "color": "#d4dbdf"
        },
        {
          "for": "j",
          "from": 0,
          "while": "j < 12",
          "step": 1,
          "body": [
            {
              "geo": ["TorusGeometry", 4.72, 0.065, 5, 24, "PI"],
              "at": [236.7, 14.3, 177.2],
              "color": "#3e6b8a",
              "rotation": [0, "(j * PI) / 12", 0]
            }
          ]
        }
      ]
    },
    "puente-arco": {
      "description": "Puente de dos arcos laterales sobre toda la luz (Puente VII Centenario): arcos circulares de acero con péndolas verticales y apoyos en los extremos. x a lo largo del tablero, z hacia los lados; la altura del arco es una estimación.",
      "params": { "rise": 9, "offset": 7, "tube": 0.35, "step": 3.5, "steel": "#2f4c6e" },
      "body": [
        { "let": { "R": "(len * len / 4 + rise * rise) / (2 * rise)" } },
        { "let": { "half": "atan2(len / 2, sqrt(R * R - len * len / 4))" } },
        {
          "for": "side",
          "in": ["offset", "-offset"],
          "body": [
            {
              "geo": ["TorusGeometry", "R", "tube", 8, 64, "2 * half"],
              "at": ["len / 2", "rise - R", "side"],
              "rotation": [0, 0, "PI / 2 - half"],
              "color": "steel"
            },
            { "box": [0.8, 0.6, "side", 1.6, 1.2, 1.2], "color": "steel" },
            { "box": ["len - 0.8", 0.6, "side", 1.6, 1.2, 1.2], "color": "steel" },
            {
              "for": "x",
              "from": "step",
              "while": "x < len - step / 2",
              "step": "step",
              "body": [
                { "let": { "top": "rise - R + sqrt(R * R - (x - len / 2) * (x - len / 2))" } },
                { "box": ["x", "top / 2", "side", 0.08, "top", 0.08], "color": "steel" }
              ]
            }
          ]
        }
      ]
    },
    "street-generic": {
      "description": "Generic street frontage: plastered wall with plinth and cornice, shopfronts or doors and framed openings with shutters or balconies per storey. Variants depend on `hash`. Equivalent to the street frontage loop of buildDetailedFacades in main 5666928.",
      "params": {
        "bayWidth": 3.35
      },
      "body": [
        {
          "let": {
            "floors": "max(1, floors)",
            "storey": "(h - 0.4) / floors",
            "shade": {
              "pick": ["#e9e5db", "#f4eee0", "#e4d8c4", "#e8e8df"],
              "index": "hash % 4"
            },
            "trim": {
              "pick": ["$cream", "#c9b78e"],
              "index": "hash % 3 == 0 ? 1 : 0"
            }
          }
        },
        {
          "box": ["len / 2", "h / 2", 0.055, "len", "h", 0.08],
          "color": "shade"
        },
        {
          "box": ["len / 2", 0.37, 0.15, "len", 0.74, 0.19],
          "color": {
            "pick": ["#b7ab96", "#aaa59b"],
            "index": "hash % 2"
          }
        },
        {
          "box": ["len / 2", "h - 0.15", 0.18, "len + 0.08", 0.17, 0.35],
          "color": "trim"
        },
        {
          "if": "floors > 1",
          "then": [
            {
              "box": ["len / 2", "storey + 0.03", 0.16, "len", 0.13, 0.24],
              "color": "trim"
            }
          ]
        },
        {
          "let": {
            "bays": "max(1, floor(len / bayWidth))",
            "step": "len / bays"
          }
        },
        {
          "for": "j",
          "from": 0,
          "while": "j < bays",
          "step": 1,
          "body": [
            {
              "let": {
                "x": "(j + 0.5) * step",
                "w": "min(1.32, step * 0.52)",
                "commercial": "commercialStreet && hash % 3 != 0"
              }
            },
            {
              "if": "commercial",
              "then": [
                {
                  "let": {
                    "width": "step * 0.8"
                  }
                },
                {
                  "box": ["x", 1.43, 0.145, "width + 0.2", 2.65, 0.14],
                  "color": "#b5ada0"
                },
                {
                  "box": ["x", 1.44, 0.235, "width", 2.42, 0.04],
                  "color": {
                    "pick": ["#8d9590", "$glass"],
                    "index": "hash % 4 == 0 ? 0 : 1"
                  }
                },
                {
                  "if": "hash % 4 == 0",
                  "then": [
                    {
                      "for": "y",
                      "from": 0.35,
                      "while": "y < 2.65",
                      "step": 0.12,
                      "body": [
                        {
                          "box": ["x", "y", 0.268, "width", 0.022, 0.025],
                          "color": "#b3b7ad"
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "box": ["x", 1.45, 0.28, 0.06, 2.4, 0.06],
                      "color": "#5f6763"
                    },
                    {
                      "box": ["x", 2.87, 0.25, "width + 0.12", 0.32, 0.15],
                      "color": {
                        "pick": ["#586d63", "#94765a", "#5e6b79"],
                        "index": "hash % 3"
                      }
                    }
                  ]
                },
                {
                  "if": "j == 0 && hash % 3 == 1",
                  "then": [
                    {
                      "box": ["x", 2.7, 0.66, "width + 0.25", 0.08, 1.12],
                      "color": "#d0c4a7",
                      "rotation": [0.16, 0, 0]
                    },
                    {
                      "box": ["x", 2.58, 1.19, "width + 0.25", 0.22, 0.045],
                      "color": "#c6b895"
                    }
                  ]
                }
              ],
              "else": [
                {
                  "if": "j == 0",
                  "then": [
                    {
                      "box": ["x", 1.36, 0.2, "w + 0.22", 2.7, 0.15],
                      "color": "trim"
                    },
                    {
                      "box": ["x", 1.32, 0.3, "w", 2.54, 0.05],
                      "color": "$wood"
                    },
                    {
                      "for": "k",
                      "from": 0,
                      "while": "k < 3",
                      "step": 1,
                      "body": [
                        {
                          "box": ["x", "0.5 + k * 0.72", 0.34, "w * 0.72", 0.51, 0.024],
                          "color": "#6e6050"
                        }
                      ]
                    }
                  ],
                  "else": [
                    {
                      "piece": "pane",
                      "args": ["x", 1.75, "w", 1.63, 0.13, true]
                    }
                  ]
                }
              ]
            },
            {
              "for": "level",
              "from": 1,
              "while": "level < floors",
              "step": 1,
              "body": [
                {
                  "let": {
                    "y": "level * storey + storey * 0.465",
                    "openingH": "min(1.87, storey * 0.64)"
                  }
                },
                {
                  "piece": "pane",
                  "args": ["x", "y", "w", "openingH", 0.12, "hash % 3 == 0"]
                },
                {
                  "if": "hash % 3 != 2",
                  "then": [
                    {
                      "piece": "balcony",
                      "args": ["x", "y - openingH / 2 - 0.085", "w + 0.32", "$iron", 0.42]
                    }
                  ],
                  "else": [
                    {
                      "for": "k",
                      "from": -2,
                      "while": "k <= 2",
                      "step": 1,
                      "body": [
                        {
                          "box": ["x + (k * w) / 5", "y - 0.43", 0.26, 0.024, 0.9, 0.035],
                          "color": "$iron"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
