{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elihu.github.io/chiclana-vice/schemas/city-design.schema.json",
  "title": "Chiclana Vice: reglas de diseño de la ciudad",
  "description": "Documentación para el editor. La referencia normativa es validateCityDesign en web/js/world/design-validate.js. Rectángulos como [minX, maxX, minZ, maxZ] en metros locales (x este, z sur).",
  "type": "object",
  "required": ["version", "zones", "frontages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "zones": {
      "description": "Rectángulos con nombre que usan los constructores del mundo.",
      "type": "object",
      "required": ["frontagePilot", "frontageOriginal"],
      "additionalProperties": false,
      "properties": {
        "frontagePilot": { "$ref": "#/$defs/rect" },
        "frontageOriginal": { "$ref": "#/$defs/rect" }
      }
    },
    "frontages": {
      "description": "Qué calles y aristas reciben frentes genéricos y con qué receta de facade-designs.json.",
      "type": "object",
      "required": [
        "streets",
        "originalStreets",
        "residentialStreets",
        "minimumEdge",
        "sideProbe",
        "maximumRoadDistance",
        "minimumSetback",
        "recipe"
      ],
      "additionalProperties": false,
      "properties": {
        "streets": { "$ref": "#/$defs/names" },
        "originalStreets": { "$ref": "#/$defs/names" },
        "residentialStreets": { "$ref": "#/$defs/names" },
        "minimumEdge": { "$ref": "#/$defs/positive" },
        "sideProbe": { "$ref": "#/$defs/positive" },
        "maximumRoadDistance": { "$ref": "#/$defs/positive" },
        "minimumSetback": { "$ref": "#/$defs/positive" },
        "recipe": { "type": "string" }
      }
    }
  },
  "$defs": {
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "nonNegative": { "type": "number", "minimum": 0 },
    "point": {
      "description": "[x, z] en metros locales.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "description": "[minX, maxX, minZ, maxZ]; el mínimo es menor que el máximo.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "names": {
      "description": "Nombres de calle tal como aparecen en osm-world.json, sin repetir.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
  }
}
