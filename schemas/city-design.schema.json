{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elihu.github.io/chiclana-vice/schemas/city-design.schema.json",
  "title": "Chiclana Vice: reglas de diseño de la ciudad",
  "description": "Documentación para el editor. La referencia normativa es validateCityDesign en web/js/world/design-validate.js. Rectángulos como [minX, maxX, minZ, maxZ] en metros locales (x este, z sur).",
  "type": "object",
  "required": [
    "version",
    "zones",
    "frontages",
    "groundFloors",
    "furniture",
    "pavements",
    "crossings",
    "centerLines",
    "signs",
    "tram",
    "vegetation",
    "buildings",
    "randomSeed"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "zones": {
      "description": "Rectángulos con nombre que usan los constructores del mundo.",
      "type": "object",
      "required": [
        "frontagePilot",
        "frontageOriginal",
        "streetLamps",
        "pavedRoads",
        "pavedSquares"
      ],
      "additionalProperties": false,
      "properties": {
        "frontagePilot": {
          "$ref": "#/$defs/rect"
        },
        "frontageOriginal": {
          "$ref": "#/$defs/rect"
        },
        "streetLamps": {
          "$ref": "#/$defs/rect",
          "description": "Zona donde se colocan las farolas de calle."
        },
        "pavedRoads": {
          "$ref": "#/$defs/rect",
          "description": "Se pavimentan las vías con algún punto estrictamente dentro."
        },
        "pavedSquares": {
          "$ref": "#/$defs/rect",
          "description": "Solo sin modelo de superficies: se pavimentan las plazas con algún punto estrictamente dentro. Con relieve se pavimentan todas las plazas."
        }
      }
    },
    "frontages": {
      "description": "Qué calles y aristas reciben frentes genéricos y con qué receta de facade-designs.json.",
      "type": "object",
      "required": [
        "streets",
        "originalStreets",
        "residentialStreets",
        "minimumEdge",
        "sideProbe",
        "maximumRoadDistance",
        "minimumSetback",
        "recipe"
      ],
      "additionalProperties": false,
      "properties": {
        "streets": {
          "$ref": "#/$defs/names"
        },
        "originalStreets": {
          "$ref": "#/$defs/names"
        },
        "residentialStreets": {
          "$ref": "#/$defs/names"
        },
        "minimumEdge": {
          "$ref": "#/$defs/positive"
        },
        "sideProbe": {
          "$ref": "#/$defs/positive"
        },
        "maximumRoadDistance": {
          "$ref": "#/$defs/positive"
        },
        "minimumSetback": {
          "$ref": "#/$defs/positive"
        },
        "recipe": {
          "type": "string"
        }
      }
    },
    "groundFloors": {
      "description": "Reglas de la clase del bajo de cada frente (shop, block, house, garage), en este orden: comercio de OSM delante del frente; uso comercial u oficinas; bloque; inmuebles de más (calle principal: shop; calle menor: garage); resto (calle principal: shop; calle menor: house). Los datos de Catastro (web/ground-floors.json) son indicios por edificio entero. Las usa js/world/ground-floors.js.",
      "type": "object",
      "required": [
        "shopDistance",
        "shopBehind",
        "shopMargin",
        "commercialUses",
        "blockMinimumDwellings",
        "blockMinimumFloors",
        "extraUnits",
        "mainRoadTypes"
      ],
      "additionalProperties": false,
      "properties": {
        "shopDistance": {
          "description": "Metros hacia fuera del frente en los que un comercio de OSM cuenta como suyo.",
          "$ref": "#/$defs/positive"
        },
        "shopBehind": {
          "description": "Metros hacia dentro del edificio en los que un comercio de OSM cuenta (OSM suele marcar el local sobre el propio edificio).",
          "$ref": "#/$defs/nonNegative"
        },
        "shopMargin": {
          "description": "Holgura en metros más allá de los extremos del frente.",
          "$ref": "#/$defs/nonNegative"
        },
        "commercialUses": {
          "description": "Valores de currentUse del Catastro que dan siempre un bajo comercial.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blockMinimumDwellings": {
          "description": "Viviendas catastrales a partir de las cuales el edificio es un bloque de pisos.",
          "type": "integer",
          "minimum": 1
        },
        "blockMinimumFloors": {
          "description": "Plantas mínimas para considerarlo bloque (varias partes de casas bajas comparten un edificio catastral con muchas viviendas).",
          "type": "integer",
          "minimum": 1
        },
        "extraUnits": {
          "description": "Inmuebles de más sobre las viviendas (numberOfBuildingUnits - numberOfDwellings) que indican local o cochera.",
          "type": "integer",
          "minimum": 1
        },
        "mainRoadTypes": {
          "description": "Tipos de vía de OSM que son calles principales o peatonales del centro (locales y portales); el resto son calles menores (casas y cocheras).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "furniture": {
      "description": "Mobiliario fijo (farolas, bancos, papeleras y bolardos). Los modelos están en el motor.",
      "type": "object",
      "required": [
        "protectedPoints",
        "protectedRadius",
        "streetLamps",
        "plazaLamps",
        "benches",
        "binOffset",
        "bollards",
        "fromOsm"
      ],
      "additionalProperties": false,
      "properties": {
        "protectedPoints": {
          "description": "Puntos sin mobiliario (misiones, miradores, entradas) en un radio protectedRadius.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "protectedRadius": {
          "$ref": "#/$defs/positive"
        },
        "streetLamps": {
          "description": "Farolas clásicas a ambos lados de las calles de frontages.originalStreets, dentro de zones.streetLamps.",
          "type": "object",
          "required": ["minimumSegment", "start", "spacing", "offset", "minimumSeparation"],
          "additionalProperties": false,
          "properties": {
            "minimumSegment": {
              "$ref": "#/$defs/positive"
            },
            "start": {
              "$ref": "#/$defs/nonNegative"
            },
            "spacing": {
              "$ref": "#/$defs/positive"
            },
            "offset": {
              "$ref": "#/$defs/nonNegative"
            },
            "minimumSeparation": {
              "$ref": "#/$defs/nonNegative"
            }
          }
        },
        "plazaLamps": {
          "description": "Farolas modernas de la plaza del Mercado, repartidas entre from y to y desplazadas shift; un banco y una papelera cada benchEvery.",
          "type": "object",
          "required": ["from", "to", "shift", "count", "benchEvery", "bench", "bin"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/point"
            },
            "to": {
              "$ref": "#/$defs/point"
            },
            "shift": {
              "$ref": "#/$defs/point"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "benchEvery": {
              "type": "integer",
              "minimum": 1
            },
            "bench": {
              "description": "[x, z, ángulo] en radianes; en plazaLamps, [dx, dz, ángulo] respecto a la farola.",
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "bin": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "benches": {
          "description": "Bancos fijos con su papelera a binOffset metros en x.",
          "type": "array",
          "items": {
            "description": "[x, z, ángulo] en radianes; en plazaLamps, [dx, dz, ángulo] respecto a la farola.",
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "binOffset": {
          "type": "number"
        },
        "bollards": {
          "description": "Bolardos a ambos lados de las calles indicadas.",
          "type": "object",
          "required": ["streets", "minimumSegment", "start", "endMargin", "spacing", "offset"],
          "additionalProperties": false,
          "properties": {
            "streets": {
              "$ref": "#/$defs/names"
            },
            "minimumSegment": {
              "$ref": "#/$defs/positive"
            },
            "start": {
              "$ref": "#/$defs/nonNegative"
            },
            "endMargin": {
              "$ref": "#/$defs/nonNegative"
            },
            "spacing": {
              "$ref": "#/$defs/positive"
            },
            "offset": {
              "$ref": "#/$defs/nonNegative"
            }
          }
        },
        "fromOsm": {
          "description": "Etiqueta OSM «clave=valor» del archivo street-objects.json → tipo de mobiliario.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z_]+=[a-z_]+$"
          },
          "additionalProperties": {
            "enum": ["lamp", "bench"]
          }
        }
      }
    },
    "pavements": {
      "description": "Pavimentos de calles y plazas.",
      "type": "object",
      "required": [
        "pedestrianTypes",
        "nonDrivableTypes",
        "minimumHalfWidth",
        "sidewalks",
        "layerHeights"
      ],
      "additionalProperties": false,
      "properties": {
        "pedestrianTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Tipos de vía OSM que se pavimentan con piedra; el resto, con asfalto."
        },
        "nonDrivableTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Tipos de vía OSM por los que no circulan vehículos (grafo de calles)."
        },
        "minimumHalfWidth": {
          "$ref": "#/$defs/positive"
        },
        "sidewalks": {
          "description": "Aceras con bordillo a ambos lados de las vías rodadas (solo visual; no cambia cotas ni transitabilidad). Se recortan contra edificios, agua, tableros y otras calzadas.",
          "type": "object",
          "required": [
            "roadTypes",
            "width",
            "minimumWidth",
            "curbWidth",
            "curbHeight",
            "curbColor",
            "step",
            "junctionMargin",
            "buildingMargin",
            "minimumRoadLength",
            "skirtMaxDepth",
            "skirtTerrainMargin",
            "skirtMinGap",
            "minimumRun"
          ],
          "additionalProperties": false,
          "properties": {
            "roadTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "Tipos de vía OSM con acera."
            },
            "width": {
              "$ref": "#/$defs/positive",
              "description": "Ancho de acera en metros, contado desde el borde de la calzada. Debe caber en terrainSurfaces.roads.shoulder para seguir la cota de la calzada."
            },
            "minimumWidth": {
              "$ref": "#/$defs/positive",
              "description": "Ancho mínimo al recortar contra edificios; por debajo no se dibuja acera."
            },
            "curbWidth": {
              "$ref": "#/$defs/positive"
            },
            "curbHeight": {
              "$ref": "#/$defs/positive",
              "description": "Altura de la acera sobre la cota de la calzada."
            },
            "curbColor": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "step": {
              "$ref": "#/$defs/positive",
              "description": "Longitud máxima de cada pieza de acera, en metros."
            },
            "junctionMargin": {
              "$ref": "#/$defs/nonNegative",
              "description": "Margen en metros antes del borde de otra calzada que cruza."
            },
            "buildingMargin": {
              "$ref": "#/$defs/nonNegative",
              "description": "Margen en metros respecto a los muros de edificios."
            },
            "minimumRoadLength": {
              "$ref": "#/$defs/nonNegative",
              "description": "Longitud mínima de la vía (suma de sus tramos) para llevar acera; enlaces y ramales cortos no la llevan."
            },
            "skirtMaxDepth": {
              "$ref": "#/$defs/positive",
              "description": "Profundidad máxima en metros del faldón vertical bajo el borde exterior de calzadas y aceras."
            },
            "skirtTerrainMargin": {
              "$ref": "#/$defs/nonNegative",
              "description": "Metros que el faldón baja por debajo del terreno para no dejar rendija."
            },
            "skirtMinGap": {
              "$ref": "#/$defs/nonNegative",
              "description": "Desnivel mínimo entre el borde y el terreno para dibujar faldón."
            },
            "minimumRun": {
              "$ref": "#/$defs/nonNegative",
              "description": "Longitud mínima en metros de un tramo continuo de acera por un lado de una vía; los tramos sueltos más cortos no se dibujan."
            }
          }
        },
        "layerHeights": {
          "description": "Altura en metros de cada capa sobre el suelo; ver docs/plan-modular/TERRENO.md.",
          "type": "object",
          "required": [
            "asphalt",
            "stone",
            "slabs",
            "centerLine",
            "crossing",
            "water",
            "deck",
            "railing"
          ],
          "additionalProperties": false,
          "properties": {
            "asphalt": {
              "$ref": "#/$defs/nonNegative"
            },
            "stone": {
              "$ref": "#/$defs/nonNegative"
            },
            "slabs": {
              "$ref": "#/$defs/nonNegative"
            },
            "centerLine": {
              "$ref": "#/$defs/nonNegative"
            },
            "crossing": {
              "$ref": "#/$defs/nonNegative"
            },
            "water": {
              "$ref": "#/$defs/nonNegative"
            },
            "deck": {
              "$ref": "#/$defs/nonNegative"
            },
            "railing": {
              "$ref": "#/$defs/nonNegative"
            }
          }
        }
      }
    },
    "crossings": {
      "description": "Pasos de peatones sobre los nodos OSM highway=crossing a menos de maximumDistance de una vía de coche de al menos minimumRoadWidth, sin puente.",
      "type": "object",
      "required": [
        "maximumDistance",
        "minimumRoadWidth",
        "halfWidthFactor",
        "edgeStart",
        "edgeEnd",
        "stripeSpacing",
        "stripeWidth",
        "stripeHalfLength"
      ],
      "additionalProperties": false,
      "properties": {
        "maximumDistance": {
          "$ref": "#/$defs/positive"
        },
        "minimumRoadWidth": {
          "$ref": "#/$defs/positive"
        },
        "halfWidthFactor": {
          "$ref": "#/$defs/positive"
        },
        "edgeStart": {
          "$ref": "#/$defs/nonNegative"
        },
        "edgeEnd": {
          "$ref": "#/$defs/nonNegative"
        },
        "stripeSpacing": {
          "$ref": "#/$defs/positive"
        },
        "stripeWidth": {
          "$ref": "#/$defs/positive"
        },
        "stripeHalfLength": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "centerLines": {
      "description": "Línea central discontinua de las vías de coche anchas.",
      "type": "object",
      "required": [
        "minimumWidth",
        "minimumLength",
        "start",
        "endMargin",
        "spacing",
        "dash",
        "halfWidth",
        "color",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "minimumWidth": {
          "$ref": "#/$defs/positive"
        },
        "minimumLength": {
          "$ref": "#/$defs/positive"
        },
        "start": {
          "$ref": "#/$defs/nonNegative"
        },
        "endMargin": {
          "$ref": "#/$defs/nonNegative"
        },
        "spacing": {
          "$ref": "#/$defs/positive"
        },
        "dash": {
          "$ref": "#/$defs/positive"
        },
        "halfWidth": {
          "$ref": "#/$defs/positive"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "signs": {
      "description": "Placas de calle: una por nombre de vía, hasta maximum.",
      "type": "object",
      "required": ["maximum", "offset", "minimumPoints"],
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "$ref": "#/$defs/nonNegative"
        },
        "minimumPoints": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tram": {
      "description": "Vías y paradas del tranvía (capa web/tram.json): solo visual, sin colisiones ni cambio de cotas.",
      "type": "object",
      "required": [
        "stripWidth",
        "sampleStep",
        "bedHeight",
        "pavedColor",
        "grassColor",
        "pavedDistance",
        "laneColor",
        "laneLineColor",
        "laneLineWidth",
        "laneMargin",
        "crossingClearance",
        "minimumGrassRun",
        "rails",
        "catenary",
        "stop"
      ],
      "additionalProperties": false,
      "properties": {
        "stripWidth": {
          "$ref": "#/$defs/positive",
          "description": "Ancho en metros de la franja del tranvía; las aceras y bordillos no la invaden."
        },
        "sampleStep": {
          "$ref": "#/$defs/positive",
          "description": "Separación en metros de las muestras de cota a lo largo de la vía."
        },
        "bedHeight": {
          "$ref": "#/$defs/nonNegative",
          "description": "Altura de la franja sobre la cota de la calzada, el tablero o el terreno."
        },
        "pavedColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "grassColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "pavedDistance": {
          "$ref": "#/$defs/nonNegative",
          "description": "Margen en metros: la franja se pavimenta (empotrada) si la vía queda a menos de medio ancho de calzada más medio ancho de franja más este margen; si no, es de césped."
        },
        "laneColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$",
          "description": "Superficie del carril exclusivo del tranvía (eje dentro de una calzada), distinta del asfalto."
        },
        "laneLineColor": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "laneLineWidth": {
          "$ref": "#/$defs/positive",
          "description": "Ancho de la línea blanca continua en cada borde del carril."
        },
        "laneMargin": {
          "$ref": "#/$defs/nonNegative",
          "description": "Margen entre el borde del carril y el borde de la calzada; el carril se desplaza hacia el eje de la calle lo justo para caber."
        },
        "crossingClearance": {
          "$ref": "#/$defs/nonNegative",
          "description": "Radio en metros alrededor de un cruce a nivel o paso peatonal del tranvía donde no se dibujan aceras ni bordillos."
        },
        "minimumGrassRun": {
          "$ref": "#/$defs/nonNegative",
          "description": "Longitud mínima en metros de un tramo de césped entre tramos empotrados; los más cortos se pavimentan."
        },
        "rails": {
          "description": "Raíles (separación = ancho de vía de OSM).",
          "type": "object",
          "required": ["width", "height", "color"],
          "additionalProperties": false,
          "properties": {
            "width": {
              "$ref": "#/$defs/positive"
            },
            "height": {
              "$ref": "#/$defs/positive"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          }
        },
        "catenary": {
          "description": "Postes, brazos e hilo de contacto.",
          "type": "object",
          "required": [
            "poleSpacing",
            "poleOffset",
            "poleWidth",
            "poleHeight",
            "armHeight",
            "armWidth",
            "wireHeight",
            "wireWidth",
            "wireStep",
            "buildingClearance",
            "color"
          ],
          "additionalProperties": false,
          "properties": {
            "poleSpacing": {
              "$ref": "#/$defs/positive",
              "description": "Separación entre postes en metros."
            },
            "poleOffset": {
              "$ref": "#/$defs/nonNegative",
              "description": "Distancia del poste al borde de la franja."
            },
            "poleWidth": {
              "$ref": "#/$defs/positive"
            },
            "poleHeight": {
              "$ref": "#/$defs/positive"
            },
            "armHeight": {
              "$ref": "#/$defs/positive"
            },
            "armWidth": {
              "$ref": "#/$defs/positive"
            },
            "wireHeight": {
              "$ref": "#/$defs/positive"
            },
            "wireWidth": {
              "$ref": "#/$defs/positive"
            },
            "wireStep": {
              "$ref": "#/$defs/positive",
              "description": "Longitud máxima de cada tramo recto del hilo."
            },
            "buildingClearance": {
              "$ref": "#/$defs/nonNegative",
              "description": "Margen respecto a edificios para colocar un poste."
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          }
        }
      },
      "stop": {
        "description": "Paradas del tranvía: andén elevado con bordillo, marquesina y poste con el nombre.",
        "type": "object",
        "required": [
          "platformHeight",
          "platformColor",
          "edgeColor",
          "tactileColor",
          "tactileWidth",
          "shelter",
          "sign"
        ],
        "additionalProperties": false,
        "properties": {
          "platformHeight": {
            "$ref": "#/$defs/positive",
            "description": "Altura del andén sobre la cota del tablero o la calzada."
          },
          "platformColor": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "edgeColor": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "tactileColor": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "tactileWidth": {
            "$ref": "#/$defs/positive",
            "description": "Ancho de la banda táctil junto al borde que da a la vía."
          },
          "shelter": {
            "description": "Marquesina sencilla: tejado, postes y cristal.",
            "type": "object",
            "required": [
              "length",
              "depth",
              "height",
              "backMargin",
              "roofThickness",
              "postWidth",
              "frameColor",
              "glassColor",
              "glassOpacity"
            ],
            "additionalProperties": false,
            "properties": {
              "length": {
                "$ref": "#/$defs/positive",
                "description": "Longitud a lo largo de la vía."
              },
              "depth": {
                "$ref": "#/$defs/positive"
              },
              "height": {
                "$ref": "#/$defs/positive"
              },
              "backMargin": {
                "$ref": "#/$defs/nonNegative",
                "description": "Distancia entre el cristal trasero y el borde exterior del andén."
              },
              "roofThickness": {
                "$ref": "#/$defs/positive"
              },
              "postWidth": {
                "$ref": "#/$defs/positive"
              },
              "frameColor": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "glassColor": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "glassOpacity": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          },
          "sign": {
            "description": "Poste con el nombre de la parada.",
            "type": "object",
            "required": [
              "alongOffset",
              "backMargin",
              "poleHeight",
              "poleWidth",
              "poleColor",
              "plateWidth",
              "plateHeight",
              "plateBase",
              "background",
              "foreground"
            ],
            "additionalProperties": false,
            "properties": {
              "alongOffset": {
                "type": "number",
                "description": "Desplazamiento a lo largo de la vía desde la parada."
              },
              "backMargin": {
                "$ref": "#/$defs/nonNegative",
                "description": "Distancia al borde exterior del andén."
              },
              "poleHeight": {
                "$ref": "#/$defs/positive"
              },
              "poleWidth": {
                "$ref": "#/$defs/positive"
              },
              "poleColor": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "plateWidth": {
                "$ref": "#/$defs/positive"
              },
              "plateHeight": {
                "$ref": "#/$defs/positive"
              },
              "plateBase": {
                "$ref": "#/$defs/nonNegative",
                "description": "Altura del borde inferior de la placa."
              },
              "background": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "foreground": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            }
          }
        }
      }
    },
    "vegetation": {
      "description": "Plantación de árboles y arbustos. Los modelos y los tonos aleatorios están en el motor.",
      "type": "object",
      "required": [
        "parkDensity",
        "parkMaximum",
        "spacing",
        "roadClearance",
        "buildingClearance",
        "marketTrees",
        "shrubEveryVertex",
        "shrubRoadClearance",
        "shrubBuildingClearance"
      ],
      "additionalProperties": false,
      "properties": {
        "parkDensity": {
          "$ref": "#/$defs/positive",
          "description": "Un intento de árbol por cada parkDensity m² de la caja del parque."
        },
        "parkMaximum": {
          "type": "integer",
          "minimum": 1,
          "description": "Máximo de intentos por parque."
        },
        "spacing": {
          "$ref": "#/$defs/positive",
          "description": "Separación mínima entre árboles."
        },
        "roadClearance": {
          "$ref": "#/$defs/nonNegative"
        },
        "buildingClearance": {
          "$ref": "#/$defs/nonNegative"
        },
        "marketTrees": {
          "description": "Árboles de la plaza del Mercado, repartidos entre from y to y desplazados shift.",
          "type": "object",
          "required": [
            "from",
            "to",
            "shift",
            "count",
            "roadClearance",
            "buildingClearance",
            "colliderClearance"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/point"
            },
            "to": {
              "$ref": "#/$defs/point"
            },
            "shift": {
              "$ref": "#/$defs/point"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "roadClearance": {
              "$ref": "#/$defs/nonNegative"
            },
            "buildingClearance": {
              "$ref": "#/$defs/nonNegative"
            },
            "colliderClearance": {
              "$ref": "#/$defs/nonNegative"
            }
          }
        },
        "shrubEveryVertex": {
          "type": "integer",
          "minimum": 1
        },
        "shrubRoadClearance": {
          "$ref": "#/$defs/nonNegative"
        },
        "shrubBuildingClearance": {
          "$ref": "#/$defs/nonNegative"
        }
      }
    },
    "buildings": {
      "description": "Edificios genéricos: paleta, colores por tipo, alturas mínimas y escala UV.",
      "type": "object",
      "required": [
        "palette",
        "detailColors",
        "minimumHeights",
        "wallUvWidth",
        "variation",
        "partyWall"
      ],
      "additionalProperties": false,
      "properties": {
        "palette": {
          "description": "Colores de edificios genéricos, elegidos por identidad de contorno.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          },
          "minItems": 1
        },
        "detailColors": {
          "description": "Color de pared por tipo de detalle de fachada.",
          "type": "object",
          "required": ["church", "townhall", "market", "street"],
          "additionalProperties": false,
          "properties": {
            "church": {
              "$ref": "#/$defs/color"
            },
            "townhall": {
              "$ref": "#/$defs/color"
            },
            "market": {
              "$ref": "#/$defs/color"
            },
            "street": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "minimumHeights": {
          "description": "Alturas mínimas especiales, aplicadas en orden: un círculo (center, radius) sobre el centro del edificio o un tipo de detalle con plantas mínimas.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["name", "center", "radius", "height"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "center": {
                    "$ref": "#/$defs/point"
                  },
                  "radius": {
                    "$ref": "#/$defs/positive"
                  },
                  "height": {
                    "$ref": "#/$defs/positive"
                  }
                }
              },
              {
                "type": "object",
                "required": ["name", "detailType", "minimumFloors", "height"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "detailType": {
                    "enum": ["market", "townhall", "church", "street"]
                  },
                  "minimumFloors": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "$ref": "#/$defs/positive"
                  }
                }
              }
            ]
          }
        },
        "wallUvWidth": {
          "$ref": "#/$defs/positive",
          "description": "Metros de pared por repetición horizontal de la textura de fachada."
        },
        "variation": {
          "type": "object",
          "required": ["seed"],
          "additionalProperties": false,
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "partyWall": {
          "description": "Medianeras expuestas (muro compartido por encima del vecino más bajo): sin huecos, con el color del edificio mezclado hacia `color` en la proporción `blend`.",
          "type": "object",
          "required": ["color", "blend"],
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            },
            "blend": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "terrainSurfaces": {
      "type": "object",
      "description": "Superficies verticales de autor. Contrato normativo validateSurfaceDesign en engine/surface-model.js; anclajes se comprueban contra el mundo cargado.",
      "required": ["version", "roads", "water", "platforms"],
      "properties": {
        "version": {
          "const": 1
        },
        "roads": {
          "type": "object",
          "required": [
            "sampleStep",
            "smoothingRadius",
            "shoulder",
            "bridgeAnchorRadius",
            "pavementStep",
            "meshSubdivisions"
          ],
          "properties": {
            "sampleStep": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "smoothingRadius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shoulder": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bridgeAnchorRadius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pavementStep": {
              "type": "number",
              "minimum": 1
            },
            "meshSubdivisions": {
              "description": "Divisiones por celda MDT en cada eje; 1 conserva el paso fuente, 2 lo reduce a la mitad y 4 a un cuarto.",
              "enum": [1, 2, 4]
            },
            "accessRadius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "maximumAccessStep": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "coverageGap": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            },
            "groundMargin": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 20
            }
          }
        },
        "water": {
          "type": "object",
          "required": [
            "percentile",
            "bedDepth",
            "shoreWidth",
            "axis",
            "sliceLength",
            "maximumSlope"
          ],
          "properties": {
            "percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bedDepth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shoreWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "axis": {
              "enum": ["x", "z"]
            },
            "sliceLength": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maximumSlope": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "kind", "areaAnchor", "evidence"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "basin"
                  },
                  "areaAnchor": {
                    "type": "object",
                    "required": ["areaId", "kind", "vertex", "vertexCount"],
                    "properties": {
                      "areaId": {
                        "type": "string",
                        "description": "ID de OSM del área; la forma sigue comprobándose"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "vertex": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "vertexCount": {
                        "type": "integer",
                        "minimum": 3
                      }
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "heightAnchors", "deckRoads", "lowerRoads", "clearance", "evidence"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "areaAnchor": {
                "type": "object",
                "required": ["areaId", "kind", "vertex", "vertexCount"],
                "properties": {
                  "areaId": {
                    "type": "string",
                    "description": "ID de OSM del área; la forma sigue comprobándose"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "vertex": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "vertexCount": {
                    "type": "integer",
                    "minimum": 3
                  }
                }
              },
              "roadAnchor": {
                "type": "object",
                "required": ["roadId", "width"],
                "properties": {
                  "roadId": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "lateralOffset": {
                    "type": "number"
                  },
                  "endExtension": {
                    "oneOf": [
                      { "type": "number", "minimum": 0 },
                      {
                        "type": "array",
                        "items": { "type": "number", "minimum": 0 },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ],
                    "description": "Prolongación de autor en metros: un número para ambos extremos del corredor o un par [inicio, fin] en el sentido de la vía; por defecto 0."
                  }
                }
              },
              "heightAnchors": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["roadId", "vertex", "offset"],
                  "properties": {
                    "roadId": {
                      "type": "string"
                    },
                    "vertex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "offset": {
                      "type": "number"
                    }
                  }
                }
              },
              "deckRoads": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "lowerRoads": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "clearance": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 9
                }
              },
              "thickness": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3
              },
              "profile": {
                "enum": ["flat", "linear"],
                "description": "flat (por defecto): tablero horizontal a la cota media de los accesos. linear: plano inclinado entre las cotas del primer y el último acceso; solo con roadAnchor."
              },
              "bands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "material", "roadAnchor"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "material": {
                      "enum": ["asphalt", "stone", "slabs"]
                    },
                    "roadAnchor": {
                      "type": "object",
                      "required": ["roadId", "width"],
                      "properties": {
                        "roadId": {
                          "type": "string"
                        },
                        "width": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "lateralOffset": {
                          "type": "number"
                        },
                        "endExtension": {
                          "oneOf": [
                            { "type": "number", "minimum": 0 },
                            {
                              "type": "array",
                              "items": { "type": "number", "minimum": 0 },
                              "minItems": 2,
                              "maxItems": 2
                            }
                          ],
                          "description": "Prolongación de autor en metros: un número para ambos extremos del corredor o un par [inicio, fin] en el sentido de la vía; por defecto 0."
                        }
                      }
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": ["areaAnchor"]
              },
              {
                "required": ["roadAnchor"]
              }
            ]
          }
        }
      }
    },
    "randomSeed": {
      "description": "Semilla de la secuencia del entorno (vegetación y actores), independiente de los edificios.",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "$defs": {
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegative": {
      "type": "number",
      "minimum": 0
    },
    "point": {
      "description": "[x, z] en metros locales.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "description": "[minX, maxX, minZ, maxZ]; el mínimo es menor que el máximo.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "names": {
      "description": "Nombres de calle tal como aparecen en osm-world.json, sin repetir.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    }
  }
}
