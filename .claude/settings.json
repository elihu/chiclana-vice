{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git filter-repo *)",
      "Bash(gh release *)",
      "Bash(npm install *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  }
}
